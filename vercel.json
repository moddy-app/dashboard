{
  "headers": [
    {
      "source": "/fonts/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/homepage-503"
    },
    {
      "source": "/index.html",
      "destination": "/api/homepage-503"
    }
  ]
}
